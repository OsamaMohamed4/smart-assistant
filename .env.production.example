# Smart Assistant — production environment (Railway Variables)
# Anything marked REQUIRED must be set or the process refuses to boot
# (lib/secrets.js). See README.md for the full table.

# ─── Node / Express ────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Proxy hops in front of Node. Railway always has exactly one. A wrong value
# lets clients spoof X-Forwarded-For and bypass rate limiting + login lockout.
TRUST_PROXY=1
# Enables the __Host- session cookie (origin-locked, Secure, Path=/).
COOKIE_SECURE=true

# ─── Database ──────────────────────────────────────────────────────
# REQUIRED. Production runs PostgreSQL; SQLite is dev only.
DB_DRIVER=postgres
DATABASE_URL=postgres://user:pass@host:5432/dbname
# Connection pool ceiling. Keep below the server's max_connections.
PG_POOL_MAX=10

# ─── AI providers ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-...                    # REQUIRED — LLM + embeddings + summaries
# One ElevenLabs workspace key covers TTS, Agents and SIP trunking.
# SERVER ONLY — no route ever exposes it to a browser.
ELEVENLABS_API_KEY=...                   # REQUIRED — agents, calls, recordings
# Signing secret from the post-call webhook you create in the ElevenLabs
# dashboard. REQUIRED: without it the webhook endpoint cannot distinguish a
# genuine delivery from a forged one, and a forged one can write call rows.
# Webhook URL to configure there: https://<domain>/webhook/elevenlabs
ELEVENLABS_WEBHOOK_SECRET=...            # REQUIRED — verifies inbound webhooks
# Optional: signs the per-company token on the in-call knowledge-base tool.
# Falls back to ELEVENLABS_WEBHOOK_SECRET. openssl rand -hex 32
# ELEVENLABS_TOOL_SECRET=
# Shared secret for the conversation-initiation webhook. That webhook is NOT
# HMAC-signed by ElevenLabs — its config accepts only {url, request_headers}, so
# a constant header is the only authentication it can carry. Register the
# webhook at https://<domain>/webhook/elevenlabs/init and add the header
#   x-elevenlabs-init-token: <this value>
# Falls back to ELEVENLABS_WEBHOOK_SECRET when unset.
# ELEVENLABS_INIT_WEBHOOK_SECRET=
# The provider reports call spend in CREDITS, never in currency. Set this to
# your workspace's dollars-per-credit rate to populate calls.cost_usd; leave it
# unset and cost_usd stays null while calls.cost_credits records what was
# actually billed. Do NOT guess a rate — a wrong one is worse than no figure.
# ELEVENLABS_USD_PER_CREDIT=
# ELEVENLABS_LLM=gpt-4.1                 # agent model override
# ELEVENLABS_API_BASE=https://api.elevenlabs.io
# ELEVENLABS_SIP_DOMAIN=sip.rtc.elevenlabs.io   # enterprise static-IP variants

# There is deliberately NO platform-wide outbound phone number. Each company
# dials from its OWN imported 3CX number (companies.elevenlabs_phone_number_id).
# A shared fallback would place one tenant's calls on another tenant's line.

# Public URL of THIS server. Required for the in-call knowledge-base tool and
# the conversation-initiation webhook, both of which call back into us.
# Railway sets RAILWAY_PUBLIC_DOMAIN automatically; override only if needed.
# PUBLIC_BASE_URL=https://your-app.up.railway.app

# ─── 3CX / SIP provisioning defaults ───────────────────────────────
# Used by scripts/elevenlabs-provision.js when importing a company's existing
# number. Digest auth is strongly preferred over IP allowlisting: an allowlist
# silently breaks the day the PBX's public IP changes.
# SIP_TRUNK_ADDRESS=pbx.example.com      # hostname or IP, NO "sip:" prefix
# SIP_TRUNK_USERNAME=
# SIP_TRUNK_PASSWORD=

# ─── Tenant isolation ──────────────────────────────────────────────
# 1 = every query carries tenant context. Must be live BEFORE running
# scripts/rls-migrate.js, or policies would be on with no context set.
RLS_ENABLED=1

# ─── Observability ─────────────────────────────────────────────────
# REQUIRED to expose /metrics. Without it /metrics returns 503 in production
# rather than publishing route latency + heap internals to anyone who asks.
METRICS_TOKEN=generate-a-long-random-string
# SENTRY_DSN=https://...ingest.sentry.io/...
# LOG_LEVEL=info

# ─── PDPL / data protection ────────────────────────────────────────
# Field encryption for calls.caller_number and campaign_contacts.phone.
# 32 bytes as hex(64) or base64:  openssl rand -hex 32
#
#   !! DO NOT SET THIS UNTIL BACKUPS ARE VERIFIED.
#   Losing this key makes the encrypted columns permanently unreadable.
#   Reads tolerate both plaintext and ciphertext, so enabling it later is a
#   non-event — rows convert as they are next written.
# DATA_ENCRYPTION_KEY=

# Retention, in days. Unset/0 = keep forever (the safe default — nothing is
# ever deleted unless you opt in).
# RETENTION_DAYS_CALLS=365
# RETENTION_DAYS_CHATS=365
# RETENTION_DAYS_AUDIT=730
# RETENTION_DAYS_WEBHOOKS=30

# Phone-number masking in logs. On by default; set 0 only to debug.
# LOG_REDACT_PII=0

# ─── Background jobs ───────────────────────────────────────────────
# Without REDIS_URL, workers fall back to in-process timers, which means the
# app MUST stay at a single replica.
# REDIS_URL=redis://default:pass@host:6379

# ─── Voice tuning ──────────────────────────────────────────────────
# Speaking pace, 0.7–1.2. 1.2 (faster) is the tuned default.
# VOICE_SPEED_DEFAULT=1.2
# Extra ElevenLabs voice ids selectable in settings (comma-separated).
# EXTRA_VOICE_IDS=
#
# NOTE: the ENDPOINT_* and TRANSCRIBER_JSON knobs are gone. They configured the
# previous provider's STT bridge (including the Arabic-pinned Gemini
# transcriber); ElevenLabs Agents use their own ASR with no provider choice and
# no per-stage endpointing controls. Re-measure with scripts/profile-calls.js.

# ─── Usage caps (cost circuit breaker) ─────────────────────────────
# Platform defaults. Per-company overrides are superadmin-only.
# DAILY_MSG_CAP=2000
# DAILY_OUTBOUND_CAP=200
# AGENT_RATE_PER_MIN=120
# Per-company ceiling on in-call knowledge-base searches. Each one costs an
# embedding request plus a vector search, and the agent decides how often to
# call it — a model stuck in a tool loop would otherwise bill without limit.
# DAILY_KB_TOOL_CAP=1000

# ─── Offsite backups (configured separately) ───────────────────────
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_ENDPOINT=
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14

# NOTE: Twilio was fully removed in July 2026, and Vapi in September 2026.
# Telephony is: landline -> 3CX PBX -> SIP trunk -> ElevenLabs Agents.
# Do not add TWILIO_* or VAPI_* variables — nothing reads them.
# NOTE: ELEVENLABS_VOICE_ID is ignored — the default voice is set in code
# (DEFAULT_VOICE_ID) so a stale env var cannot silently override it.
