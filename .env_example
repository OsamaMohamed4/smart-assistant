# OpenAI — the agent's LLM, embeddings for RAG, and post-call summaries.
OPENAI_API_KEY=sk-...

# ─── ElevenLabs (voice) ───────────────────────────────────────────
# One workspace key covers TTS, the Agents platform and SIP trunking.
# SERVER ONLY — this is never sent to the browser.
ELEVENLABS_API_KEY=...

# Signing secret shown when you create the post-call webhook in the ElevenLabs
# dashboard (Agents → Settings → Webhooks). Required: without it the webhook
# endpoint cannot tell a real delivery from a forged one.
# Point the webhook at:  https://<your-domain>/webhook/elevenlabs
ELEVENLABS_WEBHOOK_SECRET=

# Optional. Signs the per-company token on the in-call knowledge-base tool.
# Falls back to ELEVENLABS_WEBHOOK_SECRET; set it separately only if you want
# the two rotated independently. Generate with: openssl rand -hex 32
ELEVENLABS_TOOL_SECRET=

# Optional. Shared secret for the conversation-initiation webhook. That webhook
# is NOT HMAC-signed by ElevenLabs — its config accepts only {url,
# request_headers} — so authentication is a constant header instead. Register
# the webhook at https://<your-domain>/webhook/elevenlabs/init with the header
#   x-elevenlabs-init-token: <this value>
# Falls back to ELEVENLABS_WEBHOOK_SECRET when unset.
ELEVENLABS_INIT_WEBHOOK_SECRET=

# Optional overrides.
# Dollars per ElevenLabs credit, for calls.cost_usd. Unset => cost_usd stays
# null and only calls.cost_credits is recorded. The API reports no fiat amount.
# ELEVENLABS_USD_PER_CREDIT=
# DAILY_KB_TOOL_CAP=1000                       # in-call KB searches per company
# ELEVENLABS_API_BASE=https://api.elevenlabs.io
# ELEVENLABS_LLM=gpt-4.1                       # the agent's model
# ELEVENLABS_SIP_DOMAIN=sip.rtc.elevenlabs.io  # enterprise static-IP variants

# Public URL of THIS server. Required for the in-call knowledge-base tool and
# the conversation-initiation webhook, which ElevenLabs calls back on.
PUBLIC_BASE_URL=

# ─── 3CX / SIP (used by scripts/elevenlabs-provision.js) ──────────
# Each company keeps its OWN existing 3CX number; nothing is bought from
# ElevenLabs. These are defaults for the provisioning script — it takes the
# same values as flags.
# SIP_TRUNK_ADDRESS=pbx.example.com   # hostname or IP, NO "sip:" prefix
# SIP_TRUNK_USERNAME=
# SIP_TRUNK_PASSWORD=

# ─── Server ───────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
TRUST_PROXY=

# Public Agent HTTP API (POST /api/v1/agent/chat).
# Legacy platform-wide key. Prefer per-company keys (Companies → API keys),
# which scope the caller to a single tenant. Generate: openssl rand -hex 32
AGENT_API_KEY=
